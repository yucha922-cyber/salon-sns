# ------------------------------------------------------------
# NAORU AI Marketing Partner — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ------------------------------------------------------------

# --- Supabase (Auth + PostgreSQL + RLS) ---
# 未設定の場合、アプリは Demo モード（サーバー内メモリ保存・デモ認証）で起動します。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。Publish Queue / Insights同期ワーカー、トークン保管庫、メディアStorageに使用（絶対にNEXT_PUBLIC_を付けない）
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (メール確認リンク・OAuthリダイレクトの基準URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 省略時は NEXT_PUBLIC_SITE_URL を使用
NEXT_PUBLIC_APP_URL=

# --- Demo mode ---
# true にすると Supabase の設定有無に関わらず Demo モードで起動します（ブラウザ確認・Vercel Preview 用）。
# 本番（実データ）環境では false または未設定にしてください。
NEXT_PUBLIC_DEMO_MODE=false
# Demo モードのセッションCookie署名用シークレット（本番では必ず長いランダム値に）
DEMO_SESSION_SECRET=change-me-to-a-long-random-string

# --- AI provider (server only; never prefix with NEXT_PUBLIC_) ---
# mock | anthropic | openai  （未指定時: キーがあれば anthropic → openai、なければ mock）
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- SNS連携（Instagram / Threads）: すべてサーバー専用 ---
# Instagram API with Instagram Login（App Dashboard → Instagram → API setup with Instagram login の「Instagram app ID / secret」）
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 省略時: ${NEXT_PUBLIC_APP_URL}/api/social/callback/instagram
INSTAGRAM_REDIRECT_URI=
# Graph APIバージョン（Metaの変更に合わせて更新）
INSTAGRAM_GRAPH_API_VERSION=v26.0

# Threads API（App Dashboard → 「Access the Threads API」ユースケースの Threads app ID / secret。Meta App IDとは別）
THREADS_APP_ID=
THREADS_APP_SECRET=
# 省略時: ${NEXT_PUBLIC_APP_URL}/api/social/callback/threads（HTTPS必須・localhost不可）
THREADS_REDIRECT_URI=
THREADS_GRAPH_API_VERSION=v1.0
# ホスト変更に備えて上書き可能（既定: https://graph.threads.com / https://www.threads.com/oauth/authorize）
# THREADS_GRAPH_BASE_URL=
# THREADS_AUTHORIZE_URL=

# アクセストークン暗号化キー（AES-256-GCM, 32バイト）: openssl rand -base64 32
# Supabaseモードの本番では必須。紛失すると全アカウントの再接続が必要になります。
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Webhook検証トークン（App Dashboard の Webhooks 設定と同じ値）
META_WEBHOOK_VERIFY_TOKEN=
# /api/cron/social の認証（Authorization: Bearer <CRON_SECRET>）: openssl rand -hex 32
CRON_SECRET=
# mock にすると実組織でも MockSocialProvider を使用（ステージング・E2E用）。通常は未設定
SOCIAL_PROVIDER_MODE=

# --- Meta広告（Marketing API）: すべてサーバー専用 ---
# Meta App（ビジネスタイプ）の App ID / App Secret
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business の「構成（Configuration）ID」。権限（ads_read / ads_management / business_management）とトークン種別をまとめて指定
META_ADS_CONFIG_ID=
# 省略時: ${NEXT_PUBLIC_APP_URL}/api/ads/callback（App DashboardのValid OAuth Redirect URIsに登録）
META_ADS_REDIRECT_URI=
# Marketing APIバージョン（v24は2026-10-06に失効。v26.0が2026-10時点の最新）
META_GRAPH_API_VERSION=v26.0
# テスト用Creativeを作るときのFacebookページ / Instagramアカウント（広告アカウントごとにmetadataで上書き可）
META_ADS_PAGE_ID=
META_ADS_INSTAGRAM_USER_ID=
# mock にすると実組織でも MockAdsProvider を使用（ステージング・E2E用）。通常は未設定
ADS_PROVIDER_MODE=
# /api/cron/ads も CRON_SECRET で認証します（vercel.json で毎日 03:37 JST）
